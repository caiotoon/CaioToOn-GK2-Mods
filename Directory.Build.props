<Project>
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Graveyard Keeper 2</GameDir>
    <ManagedDir>$(GameDir)\GraveyardKeeper2_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <!-- Where BepInEx.dll / 0Harmony.dll are read from at compile time. Override with -p:BepInExCoreDir=... when the loader is not installed in the game folder. -->
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(BepInExDir)\core</BepInExCoreDir>

    <Authors>caiotoon</Authors>
    <Company>CaioToOn</Company>
    <Product>CaioToOn GK2 Mods</Product>
    <RepositoryUrl>https://github.com/caiotoon/CaioToOn-GK2-Mods</RepositoryUrl>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugType>portable</DebugType>
    <!-- Game assemblies are not strong-named / may be older; silence unification noise -->
    <NoWarn>$(NoWarn);CS1701;CS1702;CS8632</NoWarn>
    <!-- MSB3277: game assemblies reference newer System.* facade versions than the netstandard2.1 ref pack; irrelevant at runtime -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>
</Project>
